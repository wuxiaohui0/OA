PORT=9000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Set true behind HTTPS in production. Keep false for local HTTP development.
AUTH_COOKIE_SECURE=false
# Relative paths are resolved against apps/api, including when launched from the project root.
DATABASE_PATH=./data/smart-oa.db

# OpenAI API 规范兼容模型。Base URL 通常需要包含 /v1。
# 未配置 OPENAI_API_KEY 时，对话不可用，可通过业务表单办理；辅助审核使用本地规则。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# 0 表示 Agent 整轮不设置硬超时；运行中可由用户主动暂停。
AGENT_TIMEOUT_MS=0

# 某些企业网关需要额外请求头，值必须是 JSON 字符串对象。
# OPENAI_DEFAULT_HEADERS_JSON={"X-Tenant-Id":"your-tenant"}
